@namespace GamesPlatform.Client.Shared
@* Боковое меню навигации с адаптивным отображением по ролям *@
<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">🎮 Games Platform</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu toggle" id="navbar-toggler" />
<label for="navbar-toggler" class="navbar-toggler" aria-label="Toggle navigation"></label>

<div class="nav-scrollable" onclick="document.getElementById('navbar-toggler').checked = false;">
    <nav class="flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door" aria-hidden="true"></span> Главная
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="games">
                <span class="bi bi-grid" aria-hidden="true"></span> Каталог игр
            </NavLink>
        </div>
        @if (IsAuthenticated)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="games/create">
                    <span class="bi bi-plus-circle" aria-hidden="true"></span> Добавить игру
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="profile">
                    <span class="bi bi-person" aria-hidden="true"></span> Профиль
                </NavLink>
            </div>
            @if (UserRole == "Admin")
            {
                <div class="nav-item px-3">
                    <NavLink class="nav-link text-warning" href="admin">
                        <span class="bi bi-shield-lock" aria-hidden="true"></span> Админ-панель
                    </NavLink>
                </div>
            }
        }
    </nav>
</div>

@code {
    [Parameter] public bool IsAuthenticated { get; set; }
    [Parameter] public string? UserRole { get; set; }
}