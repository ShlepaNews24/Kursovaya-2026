@page "/login"
@inject IAuthService AuthService
@inject NavigationManager Nav
@inject INotificationService Notify

<PageTitle>Login</PageTitle>

<h3>Sign In</h3>

<div class="card" style="max-width: 400px;">
    <div class="card-body">
        <form @onsubmit="HandleLogin">
            <div class="mb-3">
                <label class="form-label">Email</label>
                <input type="email" class="form-control" @bind="email" required placeholder="user@example.com" />
            </div>
            <div class="mb-3">
                <label class="form-label">Password</label>
                <input type="password" class="form-control" @bind="password" required placeholder="********" />
            </div>
            
            <button type="submit" class="btn btn-primary w-100" disabled="@isLoading">
                @if (isLoading)
                {
                    <span class="spinner-border spinner-border-sm"></span> <span>Signing in...</span>
                }
                else
                {
                    <span>Sign In</span>
                }
            </button>
        </form>
        
        <div class="mt-3 text-center">
            <small>No account? <a href="/register">Register here</a></small>
        </div>
    </div>
</div>

@code {
    private string email = "";
    private string password = "";
    private bool isLoading = false;

    private async Task HandleLogin()
    {
        if (string.IsNullOrWhiteSpace(email) || string.IsNullOrWhiteSpace(password))
        {
            Notify.Show("Please fill all fields", "error");
            return;
        }

        isLoading = true;
        StateHasChanged();

        try
        {
            var success = await AuthService.LoginAsync(email, password);
            if (success) Nav.NavigateTo("/games", forceLoad: true);
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }
}