@* [НАЗНАЧЕНИЕ] Страница деталей игры с рабочим рейтингом *@
@* [ФАЙЛ] Pages/GameDetails.razor *@
@page "/game/{Id:int}"
@inject IGamesService GamesService
@inject IAuthService AuthService
@inject INotificationService Notify
@inject NavigationManager Nav

<PageTitle>@(game?.GameTitle ?? "Game")</PageTitle>

@if (isLoading) 
{ 
    <div class="text-center py-5">
        <div class="spinner-border text-primary" role="status"></div>
        <p class="mt-2"><span>Loading...</span></p>
    </div>
}
else if (game == null) 
{ 
    <div class="alert alert-danger"><span>Game not found</span></div> 
}
else
{
    <div class="row">
        @* Левая колонка: Инфо *@
        <div class="col-md-4 mb-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body text-center">
                    @if (!string.IsNullOrEmpty(game.Logo))
                    {
                        <img src="@game.Logo" 
                             class="mb-3 rounded shadow-sm" 
                             style="width: 180px; height: 180px; object-fit: cover;" 
                             alt="@game.GameTitle" />
                    }
                    else
                    {
                        <div class="mb-3 rounded shadow-sm bg-secondary d-flex align-items-center justify-content-center text-white"
                             style="width: 180px; height: 180px; margin: 0 auto;">
                            <span>No Logo</span>
                        </div>
                    }

                    <h4 class="card-title"><span>@game.GameTitle</span></h4>
                    <p class="text-muted small"><span>@game.ReleaseDate.ToShortDateString()</span></p>
                    
                    @if (!string.IsNullOrWhiteSpace(game.Description))
                    {
                        <div class="alert alert-secondary text-start mt-3">
                            <small><span>@game.Description</span></small>
                        </div>
                    }
                </div>
            </div>
        </div>

        @* Правая колонка: Игра и РЕЙТИНГ *@
        <div class="col-md-8">
            
            @* ✅ БЛОК РЕЙТИНГА (Исправлен) *@
            <div class="card mb-4 shadow-sm border-warning">
                <div class="card-header bg-warning text-dark">
                    <h5 class="mb-0"><span>⭐ Rate this Game</span></h5>
                </div>
                <div class="card-body">
                    @if (rating != null)
                    {
                        <div class="mb-3 text-center">
                            <span class="me-2 h4">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    <span style="color: @(i <= rating.AverageRating ? "#ffc107" : "#ddd"); font-size: 1.5rem;">★</span>
                                }
                            </span>
                            <div class="text-muted">
                                <span>@rating.AverageRating.ToString("0.0") из 5</span> 
                                <small>(@rating.TotalVotes голосов)</small>
                            </div>
                            @if (rating.UserRating.HasValue)
                            {
                                <div class="mt-1 text-success small">
                                    <span>Ваша оценка: @rating.UserRating.Value ★</span>
                                </div>
                            }
                        </div>
                    }
                    
                    @if (isAuthenticated)
                    {
                        <hr />
                        <div class="text-center">
                            <p class="mb-2"><span>Ваша оценка:</span></p>
                            <div class="btn-group" role="group">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    var starValue = i;
                                    <button type="button" 
                                            class="btn btn-outline-warning @(i <= userRatingValue ? "active" : "")"
                                            @onclick="() => SubmitRating(starValue)"
                                            disabled="@isRating">
                                        <span>★ @i</span>
                                    </button>
                                }
                            </div>
                            @if (isRating)
                            {
                                <span class="spinner-border spinner-border-sm ms-2 text-warning" role="status"></span>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="mb-0 text-center text-muted">
                            <span><a href="/login"><span>Войдите</span></a>, чтобы оценить игру.</span>
                        </p>
                    }
                </div>
            </div>

            @* Окно игры *@
            <div class="card mb-4 shadow-sm">
                <div class="card-header"><h5><span>Play Game</span></h5></div>
                <div class="card-body">
                    @if (!string.IsNullOrEmpty(game.GameUrl))
                    {
                        <div class="mx-auto" style="max-width: 900px;">
                            <div class="ratio ratio-16x9 rounded overflow-hidden shadow" style="background: #000;">
                                <iframe src="@game.GameUrl" 
                                        sandbox="allow-scripts allow-same-origin allow-pointer-lock allow-forms allow-popups"
                                        style="border: none; width: 100%; height: 100%;"
                                        title="@game.GameTitle"
                                        loading="lazy">
                                </iframe>
                            </div>
                        </div>
                        <div class="text-center mt-3">
                            <a href="@game.GameUrl" class="btn btn-outline-primary btn-sm" target="_blank">
                                <span>Open in new tab</span>
                            </a>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-warning"><span>No game URL provided.</span></div>
                    }
                </div>
            </div>
        </div>
    </div>

    @* Комментарии *@
    <div class="card mb-4 shadow-sm">
        <div class="card-header"><h5><span>Comments (@(comments?.Count ?? 0))</span></h5></div>
        <div class="card-body">
            @if (comments?.Any() == true)
            {
                <ul class="list-group mb-3">
                    @foreach (var c in comments)
                    {
                        <li class="list-group-item">
                            <strong><span>@(c.UserName ?? $"User {c.UserId}")</span></strong>: <span>@c.CommentText</span>
                            <small class="text-muted d-block"><span>@c.CreatedDate.ToShortDateString()</span></small>
                        </li>
                    }
                </ul>
            }
            else 
            { <p class="text-muted mb-3"><span>No comments yet.</span></p> }

            @if (isAuthenticated)
            {
                <div class="input-group">
                    <textarea class="form-control" @bind="newComment" placeholder="Write a comment..." rows="2" maxlength="500"></textarea>
                    <button class="btn btn-primary" @onclick="AddComment" disabled="@(string.IsNullOrWhiteSpace(newComment))">
                        <span>Send</span>
                    </button>
                </div>
            }
        </div>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }
    
    private GameDto? game;
    private List<CommentDto>? comments = new();
    
    // ✅ Правильный тип для рейтинга
    private RatingSummaryDto? rating; 
    
    private string newComment = "";
    private bool isLoading = true;
    private bool isAuthenticated = false;
    private bool isRating = false;
    private int userRatingValue = 0; // Текущая выбранная оценка (1-5)

    protected override async Task OnInitializedAsync()
    {
        await LoadGameData();
    }

    private async Task LoadGameData()
    {
        isLoading = true;
        StateHasChanged();
        
        try
        {
            game = await GamesService.GetGameAsync(Id);
            comments = await GamesService.GetCommentsAsync(Id) ?? new();
            
            // Загружаем рейтинг
            rating = await GamesService.GetRatingAsync(Id);
            if (rating?.UserRating.HasValue == true)
            {
                userRatingValue = rating.UserRating.Value;
            }
            
            isAuthenticated = await AuthService.IsAuthenticatedAsync();
        }
        catch (Exception ex)
        {
            Notify.Show($"Error: {ex.Message}", "error");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    // ✅ Метод отправки рейтинга
    private async Task SubmitRating(int value)
    {
        if (isRating || !isAuthenticated) return;
        
        isRating = true;
        StateHasChanged();
        
        try
        {
            bool success = await GamesService.AddRatingAsync(Id, value);
            
            if (success)
            {
                Notify.Show("Спасибо за оценку!", "success");
                
                // ✅ Перезагружаем данные рейтинга с сервера, чтобы увидеть новое среднее
                var newRating = await GamesService.GetRatingAsync(Id);
                if (newRating != null)
                {
                    rating = newRating;
                    userRatingValue = value; // Обновляем визуальное выделение
                }
            }
            else
            {
                Notify.Show("Не удалось отправить оценку", "error");
            }
        }
        catch (Exception ex)
        {
            Notify.Show($"Ошибка: {ex.Message}", "error");
        }
        finally
        {
            isRating = false;
            StateHasChanged();
        }
    }

    private async Task AddComment()
    {
        if (string.IsNullOrWhiteSpace(newComment)) return;
        
        var userIdStr = await AuthService.GetUserIdAsync();
        if (string.IsNullOrEmpty(userIdStr) || !int.TryParse(userIdStr, out var userId))
        {
            Notify.Show("Error: user not identified", "error");
            return;
        }
        
        var success = await GamesService.AddCommentAsync(new CommentDto 
        { 
            GameId = Id, 
            UserId = userId, 
            CommentText = newComment.Trim(), 
            CreatedDate = DateTime.UtcNow 
        });
        
        if (success) 
        { 
            var userName = await AuthService.GetUserNameAsync() ?? "You";
            comments?.Add(new CommentDto 
            { 
                CommentText = newComment.Trim(), 
                UserId = userId, 
                CreatedDate = DateTime.UtcNow,
                UserName = userName 
            }); 
            newComment = ""; 
            StateHasChanged(); 
        }
    }
}