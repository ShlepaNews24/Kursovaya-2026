@page "/admin"
@using GamesPlatform.Client.Models
@inject IAuthService AuthService
@inject INotificationService Notify
@inject NavigationManager Nav

<PageTitle>Панель администратора</PageTitle>

@if (!isLoaded)
{
    <div class="text-center py-5">
        <div class="spinner-border text-primary"></div>
        <p class="mt-2">Загрузка...</p>
    </div>
}
else if (!isAuthenticated || userRole != "Admin")
{
    <div class="alert alert-danger">Доступ запрещён. Требуется роль администратора.</div>
}
else
{
    <h3 class="page-title-block">Панель администратора</h3>

    <ul class="nav nav-tabs mb-3">
        <li class="nav-item">
            <a class="@(activeTab == "users" ? "nav-link active" : "nav-link")" 
               @onclick='() => activeTab = "users"'>
                Пользователи
            </a>
        </li>
    </ul>

    @if (activeTab == "users")
    {
        @if (users == null)
        {
            <div class="alert alert-warning">Не удалось загрузить пользователей</div>
        }
        else if (!users.Any())
        {
            <div class="alert alert-info">Пользователи не найдены</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Имя пользователя</th>
                            <th>Email</th>
                            <th>Роль</th>
                            <th>Статус</th>
                            <th>Дата рег.</th>
                            <th>Действия</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var u in users)
                        {
                            <tr>
                                <td>@u.UserId</td>
                                <td>@u.UserName</td>
                                <td>@u.Email</td>
                                <td>
                                    <span class="badge @(u.UserType == "Admin" ? "bg-danger" : "bg-primary")">@(u.UserType == "Admin" ? "Админ" : "Пользователь")</span>
                                </td>
                                <td>
                                    <span class="badge @(u.IsActive ? "bg-success" : "bg-secondary")">@(u.IsActive ? "Активен" : "Заблокирован")</span>
                                 </td>
                                <td>@u.RegistrationDate.ToShortDateString()</td>
                                <td>
                                    <div class="btn-group btn-group-sm">
                                        <button class="btn btn-outline-primary" 
                                                @onclick="() => ToggleRole(u)" 
                                                disabled="@(isProcessing || u.UserType == "Admin")">
                                            Сделать админом
                                        </button>
                                        <button class="btn btn-outline-warning" 
                                                @onclick="() => ToggleStatus(u)" 
                                                disabled="@isProcessing">
                                            @(u.IsActive ? "Заблокировать" : "Разблокировать")
                                        </button>
                                        <button class="btn btn-outline-danger" 
                                                @onclick="() => ConfirmDelete(u)" 
                                                disabled="@(isProcessing || u.UserType == "Admin")">
                                            Удалить
                                        </button>
                                    </div>
                                 </td>
                             </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }
}

@code {
    private bool isLoaded = false;
    private bool isAuthenticated = false;
    private bool isProcessing = false;
    private string userRole = "";
    private string activeTab = "users";
    private List<UserDto>? users;
    private UserDto? userToDelete;

    protected override async Task OnInitializedAsync()
    {
        isAuthenticated = await AuthService.IsAuthenticatedAsync();
        if (isAuthenticated)
        {
            userRole = await AuthService.GetUserRoleAsync() ?? "";
            if (userRole == "Admin")
            {
                users = await AuthService.GetUsersAsync();
            }
        }
        isLoaded = true;
    }

    private async Task ToggleRole(UserDto user)
    {
        isProcessing = true;
        StateHasChanged();
        try
        {
            var newRole = user.UserType == "Admin" ? "User" : "Admin";
            if (await AuthService.UpdateUserRoleAsync(user.UserId, newRole))
            {
                user.UserType = newRole;
                StateHasChanged();
            }
        }
        finally { isProcessing = false; StateHasChanged(); }
    }

    private async Task ToggleStatus(UserDto user)
    {
        isProcessing = true;
        StateHasChanged();
        try
        {
            if (await AuthService.UpdateUserStatusAsync(user.UserId, !user.IsActive))
            {
                user.IsActive = !user.IsActive;
                StateHasChanged();
            }
        }
        finally { isProcessing = false; StateHasChanged(); }
    }

    private void ConfirmDelete(UserDto user)
    {
        userToDelete = user;
        _ = DeleteUser();
    }

    private async Task DeleteUser()
    {
        if (userToDelete == null) return;
        isProcessing = true;
        StateHasChanged();
        try
        {
            if (await AuthService.DeleteUserAsync(userToDelete.UserId))
            {
                users?.Remove(userToDelete);
                StateHasChanged();
            }
        }
        finally { isProcessing = false; userToDelete = null; StateHasChanged(); }
    }
}