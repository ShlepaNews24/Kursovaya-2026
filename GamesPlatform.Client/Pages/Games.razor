@page "/games"
@inject IGamesService GamesService
@inject INotificationService Notify

<PageTitle><span>Games Catalog</span></PageTitle>

<h3><span>Games Catalog</span></h3>

@* Поиск *@
<div class="row mb-3">
    <div class="col-md-6">
        <input type="text" class="form-control" placeholder="Поиск по названию..." @bind="searchText" />
    </div>
    <div class="col-md-3">
        <button class="btn btn-primary w-100" @onclick="LoadGames"><span>Найти</span></button>
    </div>
</div>

@if (isLoading)
{
    <div class="text-center py-5">
        <div class="spinner-border text-primary"></div>
        <p class="mt-2"><span>Загрузка...</span></p>
    </div>
}
else if (pagedGames.Items.Count == 0)
{
    <div class="alert alert-info"><span>Игры не найдены.</span></div>
}
else
{
    <div class="row">
        @foreach (var game in pagedGames.Items)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100 shadow-sm">
                    @if (!string.IsNullOrEmpty(game.Logo))
                    {
                        <img src="@game.Logo" class="card-img-top" style="height: 150px; object-fit: cover;" alt="@game.GameTitle" />
                    }
                    else
                    {
                        <div class="card-img-top bg-secondary d-flex align-items-center justify-content-center text-white" style="height: 150px;">
                            <span>No Logo</span>
                        </div>
                    }
                    <div class="card-body">
                        <h5 class="card-title"><span>@game.GameTitle</span></h5>
                        <p class="card-text text-muted"><span>@(game.GenreName ?? "Unknown Genre")</span></p>
                        <a href="/game/@game.GameId" class="btn btn-primary btn-sm"><span>Играть / Подробнее</span></a>
                    </div>
                </div>
            </div>
        }
    </div>

    @* Пагинация *@
    <nav aria-label="Page navigation" class="mt-4">
        <ul class="pagination justify-content-center">
            <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                <button class="page-link" @onclick="() => ChangePage(currentPage - 1)" disabled="@(currentPage == 1)">
                    <span>← Пред.</span>
                </button>
            </li>
            <li class="page-item disabled">
                <span class="page-link"><span>Стр. @currentPage из @pagedGames.TotalPages</span></span>
            </li>
            <li class="page-item @(currentPage == pagedGames.TotalPages ? "disabled" : "")">
                <button class="page-link" @onclick="() => ChangePage(currentPage + 1)" disabled="@(currentPage == pagedGames.TotalPages)">
                    <span>След. →</span>
                </button>
            </li>
        </ul>
    </nav>
}

@code {
    private PagedResult<GameDto> pagedGames = new();
    private int currentPage = 1;
    private int pageSize = 9;
    private string searchText = "";
    private bool isLoading = true;

    protected override async Task OnInitializedAsync() => await LoadGames();

    private async Task LoadGames()
    {
        isLoading = true;
        StateHasChanged();
        
        pagedGames = await GamesService.GetGamesAsync(currentPage, pageSize, searchText);
        
        isLoading = false;
        StateHasChanged();
    }

    private async Task ChangePage(int newPage)
    {
        if (newPage < 1 || newPage > pagedGames.TotalPages) return;
        currentPage = newPage;
        await LoadGames();
    }
}