@page "/games"
@inject IGamesService GamesService
@inject INotificationService Notify

<PageTitle><span>Games Catalog</span></PageTitle>

<h3><span>Games Catalog</span></h3>

@if (isLoading)
{
    <div class="text-center py-5">
        <div class="spinner-border text-primary" role="status"></div>
        <p class="mt-2"><span>Loading games...</span></p>
    </div>
}
else if (games == null)
{
    <div class="alert alert-danger"><span>Failed to load games</span></div>
}
else if (!games.Any())
{
    <div class="alert alert-info"><span>No games yet</span></div>
}
else
{
    <!-- Пагинация -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <span>
            <span>Showing @(currentPage * pageSize + 1)-@Math.Min((currentPage + 1) * pageSize, games.Count) of @games.Count</span>
        </span>
        <div>
            <!-- ✅ Исправлено: disabled обернут в @(...) -->
            <button class="btn btn-sm btn-outline-secondary" 
                    @onclick="PreviousPage" 
                    disabled="@(currentPage == 0)">
                <span>Previous</span>
            </button>
            
            <button class="btn btn-sm btn-outline-secondary ms-2" 
                    @onclick="NextPage" 
                    disabled="@((currentPage + 1) * pageSize >= games.Count)">
                <span>Next</span>
            </button>
        </div>
    </div>

    <div class="row">
        @foreach (var game in games.Skip(currentPage * pageSize).Take(pageSize))
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100 shadow-sm">
                    <!-- ✅ ОБЛОЖКА ИГРЫ -->
                    <img src="@(!string.IsNullOrEmpty(game.Logo) ? game.Logo : "https://via.placeholder.com/400x250?text=No+Cover")" 
                         class="card-img-top" 
                         style="height: 200px; object-fit: cover;" 
                         alt="@game.GameTitle" />
                    
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title"><span>@game.GameTitle</span></h5>
                        <p class="card-text text-muted small"><span>@game.ReleaseDate.ToShortDateString()</span></p>
                        
                        <!-- Описание с обрезкой -->
                        <p class="card-text flex-grow-1 text-truncate">
                            <span>@(string.IsNullOrWhiteSpace(game.Description) ? "No description" : game.Description)</span>
                        </p>
                        
                        <div class="mt-auto">
                            <a href="/game/@game.GameId" class="btn btn-primary w-100">
                                <span>Play Game</span>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    private List<GameDto>? games;
    private bool isLoading = true;
    private int currentPage = 0;
    private const int pageSize = 6;

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        StateHasChanged();
        
        games = await GamesService.GetGamesAsync();
        
        isLoading = false;
        StateHasChanged();
    }

    private void PreviousPage() 
    { 
        if (currentPage > 0) 
        { 
            currentPage--; 
            StateHasChanged(); 
        } 
    }
    
    private void NextPage() 
    { 
        if (games != null && (currentPage + 1) * pageSize < games.Count) 
        { 
            currentPage++; 
            StateHasChanged(); 
        } 
    }
}