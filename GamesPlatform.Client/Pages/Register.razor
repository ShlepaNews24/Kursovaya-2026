@page "/register"
@using GamesPlatform.Client.Models
@inject IAuthService AuthService
@inject NavigationManager Nav
@inject INotificationService Notify

<PageTitle>Регистрация</PageTitle>

<h3 class="page-title-block">Создать аккаунт</h3>

<EditForm Model="@model" OnValidSubmit="@HandleRegister" class="card" style="max-width: 400px;">
    <DataAnnotationsValidator />
    <ValidationSummary class="alert alert-danger" />

    <div class="card-body">
        <div class="mb-3">
            <label class="form-label">Имя пользователя</label>
            <InputText class="form-control" @bind-Value="model.UserName" placeholder="GameDev123" />
            <ValidationMessage For="@(() => model.UserName)" />
        </div>
        <div class="mb-3">
            <label class="form-label">Email</label>
            <InputText class="form-control" @bind-Value="model.Email" placeholder="user@example.com" />
            <ValidationMessage For="@(() => model.Email)" />
        </div>
        <div class="mb-3">
            <label class="form-label">Пароль</label>
            <InputText type="password" class="form-control" @bind-Value="model.Password" placeholder="********" />
            <ValidationMessage For="@(() => model.Password)" />
            <small class="text-muted">Минимум 6 символов</small>
        </div>

        <button type="submit" class="btn btn-success w-100" disabled="@isLoading">
            @if (isLoading)
            {
                <span class="spinner-border spinner-border-sm"></span> <span>Регистрация...</span>
            }
            else
            {
                <span>Зарегистрироваться</span>
            }
        </button>

        <div class="mt-3 text-center">
            <small>Уже есть аккаунт? <a href="/login">Войти</a></small>
        </div>
    </div>
</EditForm>

@code {
    private RegisterViewModel model = new();
    private bool isLoading = false;

    private async Task HandleRegister()
    {
        isLoading = true;
        StateHasChanged();

        try
        {
            var (success, errorMessage) = await AuthService.RegisterAsync(model.UserName, model.Email, model.Password);
            if (success)
            {
                Notify.Show("Регистрация успешна! Теперь войдите.", "success");
                Nav.NavigateTo("/login");
            }
            else
            {
                Notify.Show(errorMessage, "error");
            }
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }
}