@page "/"
@inject IAuthService AuthService
@inject NavigationManager Nav

<PageTitle>Игровая платформа - Главная</PageTitle>

<div class="hero-section">
    <div class="hero-title-wrapper">
        <h1 class="display-4">Games Platform</h1>
        <p class="lead text-muted">Платформа браузерных игр</p>
    </div>
</div>

<div class="container py-5">
    <div class="row">
        <div class="col-md-4 mb-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body text-center">
                    <div class="mb-3">
                        <span style="font-size: 3rem;">🎯</span>
                    </div>
                    <h5 class="card-title">Играйте</h5>
                    <p class="card-text text-muted">Доступ к сотням браузерных игр в один клик</p>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body text-center">
                    <div class="mb-3">
                        <span style="font-size: 3rem;">📤</span>
                    </div>
                    <h5 class="card-title">Загружайте</h5>
                    <p class="card-text text-muted">Делитесь своими играми с сообществом</p>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body text-center">
                    <div class="mb-3">
                        <span style="font-size: 3rem;">💬</span>
                    </div>
                    <h5 class="card-title">Общайтесь</h5>
                    <p class="card-text text-muted">Оставляйте комментарии и оценки</p>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-5">
        <div class="col-md-12 text-center">
            @if (isAuthenticated)
            {
                <div class="auth-buttons d-inline-block">
                    <a href="/games" class="btn btn-primary btn-lg px-5">
                        🎮 Перейти к каталогу игр
                    </a>
                </div>
            }
            else
            {
                <div class="auth-buttons d-inline-block">
                    <a href="/login" class="btn btn-primary btn-lg px-4 me-2">🔐 Войти</a>
                    <a href="/register" class="btn btn-outline-primary btn-lg px-4">📝 Регистрация</a>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private bool isAuthenticated = false;

    protected override async Task OnInitializedAsync()
    {
        isAuthenticated = await AuthService.IsAuthenticatedAsync();
    }
}