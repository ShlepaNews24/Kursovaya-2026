@page "/profile"
@inject IAuthService AuthService
@inject NavigationManager Nav
@inject INotificationService Notify

<PageTitle><span>Profile</span></PageTitle>

@if (!isLoaded)
{
    <div class="text-center py-5">
        <div class="spinner-border text-primary" role="status"></div>
        <p class="mt-2"><span>Loading...</span></p>
    </div>
}
else if (!isAuthenticated)
{
    <div class="alert alert-warning">
        <span>⚠️ <a href="/login"><span>Login</span></a> to view profile.</span>
    </div>
}
else
{
    <h3><span>My Profile</span></h3>
    
    <div class="card mb-4" style="max-width: 500px;">
        <div class="card-body">
            <p><span><strong>Username:</strong> @userName</span></p>
            <p><span><strong>Email:</strong> @userEmail</span></p>
            <p><span><strong>Role:</strong> @userRole</span></p>
            <button class="btn btn-danger" @onclick="HandleLogout"><span>Logout</span></button>
        </div>
    </div>
    
    <div class="card" style="max-width: 500px;">
        <div class="card-header"><h5><span>Change Nickname</span></h5></div>
        <div class="card-body">
            <form @onsubmit="HandleUpdateUsername">
                <div class="mb-3">
                    <label class="form-label"><span>New Username</span></label>
                    <input type="text" class="form-control" @bind="newUserName" required minlength="3" maxlength="50" />
                    <small class="text-muted"><span>Min 3 characters</span></small>
                </div>
                
                @* ✅ ИСПРАВЛЕНО: Выражение обернуто в @(...) *@
                <button type="submit" class="btn btn-primary" disabled="@(isUpdating || string.IsNullOrWhiteSpace(newUserName))">
                    @if (isUpdating) 
                    { 
                        <span class="spinner-border spinner-border-sm"></span> <span>Updating...</span> 
                    }
                    else 
                    { 
                        <span>Update Nickname</span> 
                    }
                </button>
            </form>
        </div>
    </div>
}

@code {
    private bool isLoaded = false;
    private bool isAuthenticated = false;
    private bool isUpdating = false;
    
    private string userName = "";
    private string userEmail = "";
    private string userRole = "";
    private string newUserName = "";

    protected override async Task OnInitializedAsync()
    {
        isAuthenticated = await AuthService.IsAuthenticatedAsync();
        
        if (isAuthenticated)
        {
            var name = await AuthService.GetUserNameAsync();
            var email = await AuthService.GetUserEmailAsync();
            var role = await AuthService.GetUserRoleAsync();
            
            // ✅ Надежная инициализация с fallback
            userName = string.IsNullOrWhiteSpace(name) ? "Unknown" : name;
            userEmail = string.IsNullOrWhiteSpace(email) ? "Unknown" : email;
            userRole = string.IsNullOrWhiteSpace(role) ? "User" : role;
            
            // ✅ Гарантируем, что newUserName не пустой
            newUserName = userName;
        }
        
        isLoaded = true;
    }

    private async Task HandleUpdateUsername()
    {
        if (string.IsNullOrWhiteSpace(newUserName) || newUserName.Length < 3)
        {
            Notify.Show("Username must be at least 3 characters", "error");
            return;
        }
        
        if (newUserName.Trim() == userName)
        {
            Notify.Show("New username is the same as current", "info");
            return;
        }
        
        isUpdating = true;
        StateHasChanged();
        
        try
        {
            var success = await AuthService.UpdateUserNameAsync(newUserName.Trim());
            if (success)
            {
                userName = newUserName.Trim();
                Notify.Show("Nickname updated successfully", "success");
            }
        }
        finally
        {
            isUpdating = false;
            StateHasChanged();
        }
    }

    private async Task HandleLogout()
    {
        await AuthService.LogoutAsync();
        Nav.NavigateTo("/");
    }
}